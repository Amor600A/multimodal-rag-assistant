# ============================================================
# 环境配置示例：复制为 .env 后修改。所有文件 UTF-8。
# 策略：mock 模式零配置可启动；后端专属连接配置可留空（不校验），
#       切真实后端时按注释标注补齐必填项（见方案第 10 节校验规则）。
# ============================================================

# ---- 应用 ----
APP_NAME=Multimodal RAG Assistant
API_PREFIX=/api
LOG_LEVEL=INFO

# ---- JWT ----
JWT_SECRET=dev-only-secret-change-me        # 生产必须更换
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120                      # access token 有效期（分钟）
JWT_REFRESH_EXPIRE_DAYS=7                   # refresh token 有效期（天）

# ---- 六大后端开关（当前阶段全部 Mock）----
USER_DB_BACKEND=mock_postgres               # mock_postgres | postgres
CHECKPOINTER_BACKEND=mock_redis             # memory | mock_redis | redis | postgres
STORE_BACKEND=mock_postgres                     # in_memory | mock_postgres | postgres
VECTOR_BACKEND=mock                         # mock | milvus
LLM_BACKEND=mock                            # mock | openai_compatible
EMBEDDING_BACKEND=hash                      # hash | api
TOKEN_REVOCATION_BACKEND=memory             # memory | redis；阶段 8 切真实后端时改为 redis（见方案 14.3 / 15 节步骤 3）

# ---- LLM（LLM_BACKEND=openai_compatible 时以下四项必填）----
LLM_BASE_URL=                               # OpenAI 兼容 base_url，如 https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=                                # 对应平台 API Key
LLM_MODEL=qwen-plus                         # 文本生成模型
LLM_VISION_MODEL=qwen-vl-plus               # 图片理解模型（vision 节点用）

# ---- Embedding（EMBEDDING_BACKEND=api 时以下三项必填）----
EMBEDDING_API_BASE=                         # OpenAI 兼容嵌入接口 base_url
EMBEDDING_API_KEY=                          # 嵌入接口 API Key
EMBEDDING_MODEL=text-embedding-v3           # 嵌入模型
EMBEDDING_DIM=1536                          # 嵌入维度，须与向量库 collection 定义一致

# ---- Agent ----
AGENT_ENABLED_TOOLS=                        # 留空 = 纯 RAG 链路（ReAct 条件边不启用）；启用：已注册工具名逗号分隔，如 retrieval,memory（生效方式见方案 4.3）
MEMORY_TO_VECTOR_ENABLED=true               # 非结构化长记忆入向量库 personal 区
OUTPUT_GUARD_ENABLED=true                   # 生成侧输出护栏（引用校验 + 合规规则）
MEMORY_EXTRACTOR=rule                       # 长期记忆事实提取器：rule | llm
MEMORY_SUMMARY_EVERY_TURNS=10               # 每累计 N 轮更新一次会话摘要

# ---- Milvus（VECTOR_BACKEND=milvus 时 MILVUS_URI 必填）----
MILVUS_URI=                                 # 如 http://localhost:19530
MILVUS_COLLECTION=rag_knowledge

# ---- 真实后端连接（对应 *_BACKEND 切换时启用，mock 可留空）----
POSTGRES_DSN=                               # postgresql+asyncpg://rag:rag@localhost:5432/rag_assistant（业务表 + store 共用）
REDIS_URI=                                  # redis://localhost:6379/0（checkpointer + token 吊销共用）

# ---- 图片上传 ----
UPLOADS_DIR=uploads                         # 落盘根目录（按 user_id 分子目录）
IMAGE_MAX_MB=10                             # 单图大小上限（MB）
