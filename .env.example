# ============================================================
# 环境配置示例：复制为 .env 后修改。所有文件 UTF-8。
# 策略：mock 模式零配置可启动；后端专属连接配置可留空（不校验），
#       切真实后端时按注释标注补齐必填项（见方案第 10 节校验规则）。
# 注意：VS Code/Trae Python 扩展调试时会把 .env 注入为环境变量，
#       其解析器不剥离行内注释，因此本文件注释一律单独成行，
#       不要在值后面追加行内注释。
# ============================================================

# ---- 应用 ----
APP_NAME=Multimodal RAG Assistant
API_PREFIX=/api
LOG_LEVEL=INFO

# ---- JWT ----
# 生产必须更换
JWT_SECRET=dev-only-secret-change-me
JWT_ALGORITHM=HS256
# access token 有效期（分钟）
JWT_EXPIRE_MINUTES=120
# refresh token 有效期（天）
JWT_REFRESH_EXPIRE_DAYS=7

# ---- 六大后端开关（当前阶段全部 Mock）----
# mock_postgres | postgres
USER_DB_BACKEND=mock_postgres
# memory | mock_redis | redis | postgres
CHECKPOINTER_BACKEND=mock_redis
# in_memory | mock_postgres | postgres
STORE_BACKEND=mock_postgres
# mock | milvus_lite | milvus
VECTOR_BACKEND=mock
# mock | openai_compatible
LLM_BACKEND=mock
# hash | api | dashscope_mm
# dashscope_mm：文本/图片/视频统一向量空间（multimodal-embedding-v1，1024 维）
# api：OpenAI 兼容接口，仅支持文本模型（text-embedding-v1，1536 维）
EMBEDDING_BACKEND=hash
# memory | redis；阶段 8 切真实后端时改为 redis（见方案 14.3 / 15 节步骤 3）
TOKEN_REVOCATION_BACKEND=memory

# ---- LLM（LLM_BACKEND=openai_compatible 时以下四项必填）----
# OpenAI 兼容 base_url，如 https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=
# 对应平台 API Key
LLM_API_KEY=
# 文本生成模型
LLM_MODEL=qwen-plus
# 图片理解模型（vision 节点用）
LLM_VISION_MODEL=qwen-vl-plus

# ---- Embedding（api / dashscope_mm 时以下必填）----
# 仅 api 后端需要（OpenAI 兼容 base_url，如 https://dashscope.aliyuncs.com/compatible-mode/v1）
EMBEDDING_API_BASE=
# 嵌入接口 API Key，直接填入即可（.env 已在 .gitignore）；
# 不要写 ${DASHSCOPE_API_KEY} 插值——调试器注入 .env 时不支持插值，会覆盖为空值
EMBEDDING_API_KEY=
# dashscope_mm：multimodal-embedding-v1（固定 1024 维，文本/图片/视频同空间）
# api：text-embedding-v1（1536 维，仅文本）
EMBEDDING_MODEL=multimodal-embedding-v1
# 嵌入维度，须与模型和向量库 collection 一致
EMBEDDING_DIM=1024

# ---- Agent ----
# 留空 = 纯 RAG 链路（ReAct 条件边不启用）；启用：已注册工具名逗号分隔，如 retrieval,memory（生效方式见方案 4.3）
AGENT_ENABLED_TOOLS=
# 非结构化长记忆入向量库 personal 区
MEMORY_TO_VECTOR_ENABLED=true
# 生成侧输出护栏（引用校验 + 合规规则）
OUTPUT_GUARD_ENABLED=true
# 长期记忆事实提取器：rule | llm
MEMORY_EXTRACTOR=rule
# 每累计 N 轮更新一次会话摘要
MEMORY_SUMMARY_EVERY_TURNS=10

# ---- Milvus（VECTOR_BACKEND=milvus 时 MILVUS_URI 必填）----
# 如 http://localhost:19530
MILVUS_URI=
MILVUS_COLLECTION=rag_knowledge
# Milvus Lite 本地单文件（VECTOR_BACKEND=milvus_lite 时使用）
MILVUS_DB_PATH=data/milvus/rag_knowledge.db

# ---- 真实后端连接（对应 *_BACKEND 切换时启用，mock 可留空）----
# postgresql+asyncpg://rag:rag@localhost:5432/rag_assistant（业务表 + store 共用）
POSTGRES_DSN=
# redis://localhost:6379/0（checkpointer + token 吊销共用）
REDIS_URI=

# ---- 图片上传 ----
# 落盘根目录（按 user_id 分子目录）
UPLOADS_DIR=uploads
# 单图大小上限（MB）
IMAGE_MAX_MB=10
